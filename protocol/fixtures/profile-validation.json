{
  "description": "Casos compartilhados de normalizacao de perfil, iniciais, rotulos e envelope DataChannel",
  "normalizationCases": [
    {
      "label": "trim e truncamento em 40 caracteres com foto JPEG valida",
      "input": {
        "name": "  Alexia Maria de Oliveira Santos Pereira Silva  ",
        "photo": "data:image/jpeg;base64,QUJDRA=="
      },
      "expected": {
        "name": "Alexia Maria de Oliveira Santos Pereira",
        "photo": "data:image/jpeg;base64,QUJDRA=="
      }
    },
    {
      "label": "foto WebP valida preservada",
      "input": {
        "name": "Bia",
        "photo": "data:image/webp;base64,UklGRg=="
      },
      "expected": {
        "name": "Bia",
        "photo": "data:image/webp;base64,UklGRg=="
      }
    },
    {
      "label": "URL externa de foto deve ser descartada",
      "input": {
        "name": "Bia",
        "photo": "https://exemplo.com/avatar.png"
      },
      "expected": {
        "name": "Bia",
        "photo": ""
      }
    },
    {
      "label": "SVG data URL nao permitido deve ser descartado",
      "input": {
        "name": "Bia",
        "photo": "data:image/svg+xml;base64,PHN2Zz4="
      },
      "expected": {
        "name": "Bia",
        "photo": ""
      }
    }
  ],
  "initialsCases": [
    { "name": "Alex Silva Terceiro", "fallback": "Você", "expected": "AS" },
    { "name": "bia", "fallback": "Você", "expected": "B" },
    { "name": "", "fallback": "Você", "expected": "V" },
    { "name": "   ", "fallback": "Sua companhia", "expected": "SC" }
  ],
  "tileLabelCases": [
    { "isLocal": true, "name": "", "sharingScreen": false, "expected": "Você" },
    { "isLocal": true, "name": "", "sharingScreen": true, "expected": "Sua tela" },
    { "isLocal": true, "name": "Alex", "sharingScreen": false, "expected": "Alex · você" },
    { "isLocal": true, "name": "Alex", "sharingScreen": true, "expected": "Alex · tela" },
    { "isLocal": false, "name": "", "sharingScreen": false, "expected": "Sua companhia" },
    { "isLocal": false, "name": "", "sharingScreen": true, "expected": "Sua companhia · tela" },
    { "isLocal": false, "name": "Bia", "sharingScreen": false, "expected": "Bia" },
    { "isLocal": false, "name": "Bia", "sharingScreen": true, "expected": "Bia · tela" }
  ]
}
