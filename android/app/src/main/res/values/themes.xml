<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Unme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/cor_destaque</item>
        <item name="colorOnPrimary">@color/cor_destaque_tinta</item>
        <item name="colorSecondary">@color/cor_ao_vivo</item>
        <item name="colorSurface">@color/cor_superficie</item>
        <item name="colorOnSurface">@color/cor_texto</item>
        <item name="colorError">@color/cor_perigo_suave</item>
        <item name="android:windowBackground">@color/cor_fundo</item>
        <item name="android:statusBarColor">@color/cor_fundo</item>
        <item name="android:navigationBarColor">@color/cor_fundo</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="Theme.Unme" parent="Base.Theme.Unme" />

    <style name="TemaDialogoUnme" parent="ThemeOverlay.Material3.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.72</item>
    </style>
</resources>
