{
  "name": "unme",
  "productName": "unme",
  "version": "1.3.6",
  "description": "App desktop P2P de audio/video (2 usuarios) com WebRTC + Electron",
  "main": "main.js",
  "private": true,
  "author": "lurrlin",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "electron tests/run.cjs",
    "test:performance": "electron tests/run.cjs --performance",
    "test:build": "node --test tests/build-dependencies.test.cjs",
    "test:packaged": "electron tests/smoke.cjs --packaged",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "electron-native-screenshare": "^1.2.0",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "build": {
    "appId": "com.pessoal.unme",
    "productName": "unme",
    "files": [
      "**/*",
      "!tests{,/**/*}",
      "!**/{.gitignore,.env,.env.*,*.log,*.pem,*.key,*.p12,*.pfx}"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "icon": "assets/unme.png",
      "category": "public.app-category.social-networking",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "O Mini Discord precisa da camera para a chamada de video.",
        "NSMicrophoneUsageDescription": "O Mini Discord precisa do microfone para a chamada de audio.",
        "NSScreenCaptureDescription": "O Mini Discord precisa capturar a tela para o compartilhamento de tela.",
        "NSAudioCaptureUsageDescription": "O Unme precisa capturar o áudio da tela para compartilhar sua transmissão."
      }
    },
    "win": {
      "icon": "assets/unme.ico",
      "signtoolOptions": {
        "publisherName": "lurrlin"
      },
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "installerIcon": "assets/unme.ico",
      "uninstallerIcon": "assets/unme.ico",
      "installerHeaderIcon": "assets/unme.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
